# Local Claude Code settings (machine-specific permissions)
.claude/settings.local.json

# Rust build artifacts
lifewall/target/
lifelock/target/
lifegreet/target/
lifenote/target/
lifeconf/target/
lifecursor/target/
lifefiles/target/
lifeshot/target/
lifemenu/target/
lifeauth/target/
lifefont/target/
lifepanel/target/
lifeosd/target/
lifebar/target/
lifeportal/target/

# Zip/archive artifacts
*.zip
*.7z
*.tar
*.tar.*
.7z

# lifeconf-generated theme files: build artifacts, materialised per-machine by
# `lifeconf --apply` (see lifeconf/README.md "Generated files & git")
/waybar/style.css
/kitty/olive.conf
/fuzzel/fuzzel.ini
/lifenote/config
/swaylock/config
# Each machine's own niri settings, included by the tracked config.kdl; the
# installer creates them from local.kdl.default.
/niri/local.kdl
/macbook/niri/local.kdl

# Installer backups (detect-trackpad.sh writes the previous config here before
# rewriting the LIFEBRANCH:BEGIN touchpad region)
*.pre-touchpad
*.bak
# scripts/config-region.sh's copy of the config from before its last rewrite
*.lifebranch-prev
# ...and the file it stages a rewrite in, if a run is cut off mid-write
.lifebranch-staged.*

# Python bytecode (scripts/life.py)
__pycache__/
