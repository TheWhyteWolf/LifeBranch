# waybar as a supervised user unit instead of niri spawn-at-startup.
#
# Why: waybar has been seen to die and stay dead. A niri-spawned process is a
# one-shot scope, so when it exits the bar is simply gone until you notice and
# respawn it by hand. A coredump put the SIGSEGV inside libgdk-3 while it was
# dispatching a Wayland output event via libwayland-client; a phantom connector
# reporting itself connected with no EDID is a plausible source of those events,
# but the link was never proven. Root cause is still open, so this makes the
# symptom self-healing while the journal collects evidence.
#
# Read its output with: journalctl --user -u waybar -b

[Unit]
Description=waybar (niri status bar)
Documentation=man:waybar(5)
PartOf=graphical-session.target
After=graphical-session.target
# niri-session imports WAYLAND_DISPLAY into the systemd user manager; without it
# waybar has no compositor to attach to and would restart-loop pointlessly.
ConditionEnvironment=WAYLAND_DISPLAY
# A status bar must come back forever, never start-limit-hit into a bare screen
# — same reasoning as the greetd drop-in's StartLimitIntervalSec=0. This is a
# [Unit] key: systemd silently ignores it under [Service].
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/waybar
# SIGUSR2 is waybar's reload (config + stylesheet) — the same poke lifeconf
# sends. `systemctl --user reload waybar` is the tidy way to trigger it.
ExecReload=/bin/kill -SIGUSR2 $MAINPID
Restart=always
RestartSec=2
Slice=app.slice

[Install]
WantedBy=graphical-session.target
